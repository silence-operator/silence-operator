load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//bazel:addlicense.bzl", "license_check")

package(default_package_metadata = ["//:package_metadata"])

go_library(
    name = "v1alpha1",
    srcs = [
        "groupversion_info.go",
        "matcher.go",
        "silence_types.go",
        "zz_generated.deepcopy.go",
    ],
    importpath = "github.com/silence-operator/silence-operator/api/v1alpha1",
    visibility = ["//visibility:public"],
    deps = [
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
    ],
)

license_check()

go_test(
    name = "v1alpha1_test",
    srcs = [
        "groupversion_info_test.go",
        "matcher_test.go",
    ],
    embed = [":v1alpha1"],
    deps = ["@io_k8s_apimachinery//pkg/runtime"],
)
