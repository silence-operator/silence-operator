load("@gazelle//:def.bzl", "gazelle")
load("@package_metadata//:defs.bzl", "package_metadata")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("//bazel:addlicense.bzl", "license_check")
load("//bazel:addlicense_toolchain.bzl", ADDLICENSE_VERSION = "VERSION")
load("//bazel:gitleaks_toolchain.bzl", GITLEAKS_VERSION = "VERSION")
load("//bazel:helm_toolchain.bzl", HELM_VERSION = "VERSION")
load("//bazel:kubeconform_toolchain.bzl", KUBECONFORM_VERSION = "VERSION")
load("//bazel:kustomize_toolchain.bzl", KUSTOMIZE_VERSION = "VERSION")
load("//bazel:notice.bzl", "notice")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

gazelle(name = "gazelle")

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

license_check(
    allow_empty = True,
    patterns = ["*.bzl"],
)

# Versions below must track the bazel_dep() versions in MODULE.bazel; the toolchains export their own VERSION constant, these three don't.
notice(
    name = "notice",
    template = "//hack:notice.tpl",
    bazel_dep_licenses = [
        "@rules_go//:LICENSE.txt",
        "//bazel/third_party:gazelle-LICENSE",
        "//bazel/third_party:package_metadata-LICENSE",
        "@addlicense_toolchain//:LICENSE",
        "//bazel/third_party:kustomize-LICENSE",
        "@helm_toolchain//:LICENSE",
        "@kubeconform_toolchain//:LICENSE",
        "@gitleaks_toolchain//:LICENSE",
    ],
    bazel_deps = [
        "rules_go|0.62.0|Apache-2.0|https://github.com/bazel-contrib/rules_go",
        "gazelle|0.52.2|Apache-2.0|https://github.com/bazel-contrib/bazel-gazelle",
        "package_metadata|0.0.13|Apache-2.0|https://github.com/bazel-contrib/supply-chain",
        "addlicense|" + ADDLICENSE_VERSION + "|Apache-2.0|https://github.com/google/addlicense",
        "kustomize|" + KUSTOMIZE_VERSION + "|Apache-2.0|https://github.com/kubernetes-sigs/kustomize",
        "helm|" + HELM_VERSION + "|Apache-2.0|https://github.com/helm/helm",
        "kubeconform|" + KUBECONFORM_VERSION + "|Apache-2.0|https://github.com/yannh/kubeconform",
        "gitleaks|" + GITLEAKS_VERSION + "|MIT|https://github.com/gitleaks/gitleaks",
    ],
)
