load("@rules_go//go:def.bzl", "go_test")
load("//bazel:addlicense.bzl", "license_check")

package(default_package_metadata = ["//:package_metadata"])

go_test(
    name = "e2e_test",
    srcs = [
        "e2e_suite_test.go",
        "e2e_test.go",
    ],
    # Needs a live kind cluster; excluded from `bazel test //...`, run via `make test-e2e`.
    tags = ["manual"],
    deps = [
        "//test/utils",
        "@com_github_onsi_ginkgo_v2//:ginkgo",
        "@com_github_onsi_gomega//:gomega",
    ],
)

license_check()
