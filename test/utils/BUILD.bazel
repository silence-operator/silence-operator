load("@rules_go//go:def.bzl", "go_library")
load("//bazel:addlicense.bzl", "addlicense", "addlicense_test")

package(default_package_metadata = ["//:package_metadata"])

go_library(
    name = "utils",
    srcs = ["utils.go"],
    importpath = "github.com/silence-operator/silence-operator/test/utils",
    visibility = ["//visibility:public"],
    deps = ["@com_github_onsi_ginkgo_v2//:ginkgo"],
)

_LICENSE_SRCS = glob([
    "*.go",
    "BUILD.bazel",
])

addlicense_test(
    name = "addlicense",
    size = "small",
    srcs = _LICENSE_SRCS,
    copyright = "Silence-Operator Maintainers",
    license = "apache",
)

addlicense(
    name = "addlicense_fix",
    srcs = _LICENSE_SRCS,
    copyright = "Silence-Operator Maintainers",
    license = "apache",
)
