load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//bazel:addlicense.bzl", "license_check")

package(default_package_metadata = ["//:package_metadata"])

go_library(
    name = "observability",
    srcs = ["observability.go"],
    importpath = "github.com/silence-operator/silence-operator/internal/observability",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/tlsutil",
        "@io_k8s_sigs_controller_runtime//pkg/certwatcher",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/filters",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
    ],
)

license_check()

go_test(
    name = "observability_test",
    srcs = ["observability_test.go"],
    embed = [":observability"],
    deps = ["//internal/tlsutil"],
)
