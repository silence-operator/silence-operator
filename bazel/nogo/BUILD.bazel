load("@rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")
load("//bazel:addlicense.bzl", "license_check")
load(":staticcheck.bzl", "STATICCHECK_SA_ANALYZERS")

package(default_package_metadata = ["//:package_metadata"])

# Build-time subset of .golangci.yml's linters -- see README.md for scope.
nogo(
    name = "nogo",
    config = "config.json",
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO + STATICCHECK_SA_ANALYZERS + [
        "//bazel/nogo/unused",
        "@com_github_gordonklaus_ineffassign//pkg/ineffassign",
        "@com_github_kisielk_errcheck//errcheck",
        "@com_github_nunnatsa_ginkgolinter//:ginkgolinter",
    ],
)

license_check(patterns = ["*.bzl"])
