load("//bazel:addlicense.bzl", "addlicense", "addlicense_test")

package(default_package_metadata = ["//:package_metadata"])

filegroup(
    name = "files",
    srcs = glob(["**/*.yaml"]),
    visibility = ["//config:__subpackages__"],
)

addlicense_test(
    name = "addlicense",
    size = "small",
    srcs = ["BUILD.bazel"],
    copyright = "Silence-Operator Maintainers",
    license = "apache",
)

addlicense(
    name = "addlicense_fix",
    srcs = ["BUILD.bazel"],
    copyright = "Silence-Operator Maintainers",
    license = "apache",
)
