load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:addlicense.bzl", "addlicense", "addlicense_test")

package(default_package_metadata = ["//:package_metadata"])

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/silence-operator/silence-operator/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//api/v1alpha1",
        "//internal/alertmanager",
        "//internal/controller",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/util/runtime",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//plugin/pkg/client/auth",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/certwatcher",
        "@io_k8s_sigs_controller_runtime//pkg/config",
        "@io_k8s_sigs_controller_runtime//pkg/healthz",
        "@io_k8s_sigs_controller_runtime//pkg/log/zap",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/filters",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
        "@io_k8s_sigs_controller_runtime//pkg/webhook",
        "@io_k8s_utils//ptr",
    ],
)

go_binary(
    name = "cmd",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
)

_LICENSE_SRCS = glob([
    "*.go",
    "BUILD.bazel",
])

addlicense_test(
    name = "addlicense",
    size = "small",
    srcs = _LICENSE_SRCS,
    copyright = "Silence-Operator Maintainers",
    license = "apache",
)

addlicense(
    name = "addlicense_fix",
    srcs = _LICENSE_SRCS,
    copyright = "Silence-Operator Maintainers",
    license = "apache",
)
