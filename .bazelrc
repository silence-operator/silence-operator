# Merge per-target coverage.dat files into one combined lcov report.
coverage --combined_report=lcov

#local overrides
try-import %workspace%/.bazelrc.local

# Hermetiq · silence-operator
build:hermetiq --bes_instance_name=ea966737-4e52-4a4b-bac6-fadaa60c14a4
build:hermetiq --bes_backend=grpcs://bep.cloud-grpc.hermetiq.io
build:hermetiq --bes_results_url=https://dashboard.hermetiq.io/build/
build:hermetiq --bes_upload_mode=wait_for_upload_complete
build:hermetiq --show_progress_rate_limit=5
build:hermetiq --credential_helper="bep.cloud-grpc.hermetiq.io=%workspace%/tools/hermetiq-credential-helper.py"
build:hermetiq --credential_helper="lb.bb.cloud-grpc.hermetiq.io=%workspace%/tools/hermetiq-credential-helper.py"

# Build metadata · branch, commit and repo, so the filters work
build:hermetiq --workspace_status_command=$(pwd)/tools/set-build-metadata.sh

# Enhanced metrics · build profiles for timing and bottleneck analysis
build:hermetiq --generate_json_trace_profile
build:hermetiq --experimental_profile_include_primary_output
build:hermetiq --experimental_profile_include_target_label
build:hermetiq --noslim_profile

# Hermetiq remote cache
build:hermetiq --remote_instance_name=ea966737-4e52-4a4b-bac6-fadaa60c14a4
build:hermetiq --remote_cache=grpcs://lb.bb.cloud-grpc.hermetiq.io

# Hermetiq remote execution
build:hermetiq --remote_executor=grpcs://lb.bb.cloud-grpc.hermetiq.io
build:hermetiq --remote_default_exec_properties=pool=sizeclass

# `bazel run` (gazelle, notice) is short-lived: slim profile, no per-target detail, don't wait on the BES upload.
run:hermetiq --slim_profile
run:hermetiq --noexperimental_profile_include_primary_output
run:hermetiq --noexperimental_profile_include_target_label
run:hermetiq --bes_upload_mode=fully_async
